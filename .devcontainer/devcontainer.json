{
  "name": "SIO1 - PHP / MySQL / phpMyAdmin",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "customizations": {
    "vscode": {
      "extensions": [
        "kisstkondoros.vscode-codemetrics",
        "ms-azuretools.vscode-docker",
        "bmewburn.vscode-intelephense-client",
        "esbenp.prettier-vscode",
        "neilbrayfield.php-docblocker",
        "SonarSource.sonarlint-vscode",
        "cweijan.vscode-mysql-client2",
        "donjayamanne.githistory",
        "xdebug.php-debug" // Extension for PHP debugging with XDebug
      ]
    }
  },
  // Sans ce réglage, le trafic entre conteneurs du réseau compose est bloqué dans le codespace
  // (Apache/phpMyAdmin ne peuvent pas joindre MySQL : "Connection timed out").
  // Exécuté à chaque démarrage du codespace, puis lancement des conteneurs.
  "postStartCommand": "sudo sysctl -w net.bridge.bridge-nf-call-iptables=0 net.bridge.bridge-nf-call-ip6tables=0 || true; docker compose up -d"
}